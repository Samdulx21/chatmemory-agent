# Configuración del Servidor
PORT=3010
PREFIX=api/v1
NODE_ENV=development
TRUSTED_ORIGINS=http://localhost:3400

# Inteligencia Artificial (API Keys)
# Reemplazar con tus claves reales
API_KEY_OPENAI=tu_sk_openai_aqui
API_KEY_GENAI=tu_api_key_google_aqui

# Base de Datos y Caché (Redis)
REDIS_URL=redis://usuario:password@host:puerto
REDIS_KEY_PREFIX=chat_agent_
REDIS_TLS=false
REDIS_DB=1
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_ENABLE_OFFLINE_QUEUE=true

# Gestión de Memoria y Logs
CACHE_TTL=1800
LOG_LEVEL=debug
REDIS_HEALTH_CHECK_INTERVAL=60000

# Seguridad
X_VERIFY_TOKEN=tu_token_de_verificacion_aqui
